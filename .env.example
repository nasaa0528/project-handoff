# Copy to .env for app config. NEVER commit the filled-in file. Hard rule 2.
#
# HEDERA_ACCOUNT_ID must ALSO be exported in your shell profile, because .mcp.json
# expands it from the environment and does not read .env:
#
#     export HEDERA_ACCOUNT_ID=0.0.xxxxxx
#
# Hard rule 5: testnet only. No mainnet values in this file, ever.

# Your own testnet account, from https://portal.hedera.com/
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet

X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_PAYER_ACCOUNT_ID=0.0.xxxxxx
X402_PAYER_PRIVATE_KEY=
X402_RECEIVER_ACCOUNT_ID=0.0.xxxxxx
X402_FEE_TINYBARS=

HANDOFF_SERVICE_URL=

# Mirror node the apps read settlement state from
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Content store. The service key is vault-only and belongs to P1's shared project.
# Note Supabase renamed these: the dashboard's "secret key" (sb_secret_...) is what
# goes in SUPABASE_SERVICE_KEY, and its "publishable key" (sb_publishable_...) is
# SUPABASE_ANON_KEY. Only URL + SERVICE_KEY are actually read today.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Private bucket for artifacts and notes. Created by
# packages/content/scripts/verify-supabase.ts if it does not exist yet.
SUPABASE_BUCKET=handoff-content

# Which seat you are, for the AI usage log. P1, P2, P3 or P4.
HANDOFF_SEAT=

# Which chain apps/mcp talks to: "mock" or "testnet". Anything else is refused
# rather than falling through — a mock transaction id 404s on Hashscan and must
# never reach a recording. Everything below this line is read only when testnet.
HANDOFF_CHAIN=mock

# HCS topics (NAS-13). Provisioned on testnet 2026-09-08 by
# packages/chain/scripts/provision-topics.ts — ask P1 for the current ids rather than
# creating your own, or your app reads an empty topic while everyone else reads the
# real one. Verified with packages/chain/scripts/verify-topics.ts.
#
#   orders, attestations  no submit key, no admin key — experts publish claims and
#                         attestations from their OWN accounts, and nothing (including
#                         us) can delete the record
#   registry              submit key + admin key — platform-written only; the refusal
#                         is confirmed against testnet, not assumed
HANDOFF_ORDERS_TOPIC_ID=
HANDOFF_ATTESTATIONS_TOPIC_ID=
HANDOFF_REGISTRY_TOPIC_ID=

# Whose funds the escrow locks — the demo requester's account.
HANDOFF_REQUESTER_ACCOUNT_ID=

# The one shared escrow account, provisioned once out of band with its 2-of-3
# KeyList. Decided in docs/decisions/2026-09-07-one-shared-escrow-account-this-week.md.
# This process never creates one: an escrow made on boot holds funds nobody else
# can reach.
HANDOFF_ESCROW_ACCOUNT_ID=

# The two platform keys, VAULT-ONLY. They co-sign the payout after the expert's
# attestation validates. Server-side only — never in a workspace with a browser
# build. The expert's key is never one of these; an expert signs from their own
# account and this server refuses to publish a claim on anyone's behalf.
HANDOFF_VERIFIER_KEY=
HANDOFF_SCHEDULE_ADMIN_KEY=

# Credential tags this build routes to, as code=Label pairs. The registry owns this once NAS-27 lands.
HANDOFF_CERT_TAGS=cpa-us=Licensed reviewer
# ── Accounts API (apps/accounts-api, packages/accounts) ───────────────────────
# The registration surface: email, username, first/last name, keyed on the
# Hedera account id. A row here is a PROFILE, not custody — this service never
# creates a Hedera account and never holds a key. See
# docs/decisions/2026-09-10-registration-keyed-on-the-hedera-account.md.

# Which store: "memory" or "mongo". Anything else is refused rather than
# defaulted. memory loses every registration on restart, so it is dev-only.
HANDOFF_ACCOUNTS_STORE=memory
HANDOFF_ACCOUNTS_PORT=8788

# Only read when HANDOFF_ACCOUNTS_STORE=mongo. The URI carries credentials, so
# the filled-in file is never committed (hard rule 2).
MONGODB_URI=
MONGODB_DB=handoff

# Keys the HMAC over email codes and session tokens, so a stolen database is not
# a pile of live credentials. REQUIRED — the process will not start without it.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HANDOFF_ACCOUNTS_CODE_PEPPER=

# Origins allowed to call this from a browser, comma separated. An allowlist,
# never "*": the sign-in response body carries a bearer token. Empty = none.
# apps/web on Vite is http://localhost:5173.
HANDOFF_ACCOUNTS_CORS_ORIGINS=

# Leave false. Email verification that gates nothing is theatre.
HANDOFF_ACCOUNTS_ALLOW_UNVERIFIED_SIGNIN=false

# Only turn on behind a proxy that OVERWRITES X-Forwarded-For. The header is
# client-supplied, so trusting it with nothing in front lets one caller invent a
# new address per request and walk through the rate limiter.
HANDOFF_ACCOUNTS_TRUST_PROXY=false
