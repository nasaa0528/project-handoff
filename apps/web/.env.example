# apps/web — the expert app. Copy to .env and fill in. Never commit .env.
#
# Anything prefixed VITE_ is bundled into the browser build. That is why there is
# no private key here and never will be. How the expert's key reaches the real
# adapter is settled with packages/chain at the Mon Sep 7 cutover.

# "mock" until the cutover, then "testnet". Nothing else exists.
VITE_CHAIN=mock

# Your own testnet account. The only account this app ever signs from.
VITE_EXPERT_ACCOUNT_ID=0.0.xxxxxx

# The HCS topic orders, and until P1 says otherwise attestations, are published
# to. Required on testnet. Defaults to a MOCK- id in mock mode.
VITE_HANDOFF_ORDERS_TOPIC_ID=

# Mock mode only: whose funds the seeded demo order locks.
VITE_MOCK_REQUESTER_ACCOUNT_ID=

# Mock mode only: the seeded order's price in HBAR. Defaults to the proposed demo
# price, 200, which is still an open decision pending a faucet check. Change it
# here, never on camera.
VITE_MOCK_PRICE_HBAR=
